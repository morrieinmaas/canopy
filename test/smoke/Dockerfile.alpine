# Alpine's /bin/sh is BusyBox ash and its whole userland is BusyBox rather
# than GNU. This image is what catches a GNU-only flag in find, grep, sed,
# cp, date or stat, which nothing in this project has ever exercised:
# canopy has only ever run on macOS with GNU coreutils on the PATH.
#
# Only what canopy genuinely needs is installed: tmux, git, and a shell,
# which the base image already provides. Nothing from this repo's
# mise.toml, for the same reason as the Debian image.
#
# Finding: canopy itself never invokes git. It is here because a canopy
# install is a checkout, so a user needs git to GET canopy, not to run
# it. Everything canopy itself calls is in the BusyBox userland already.
#
# procps and bash are different, and neither is a convenience. canopy
# recognises an agent pane by asking ps what it runs, and BusyBox ps
# cannot answer that. The vendored resurrect and continuum are
# #!/usr/bin/env bash scripts, so on a box without bash they never run at
# all: no autosave, no restore, and nothing anywhere saying so. Both are
# the reason `canopy doctor` now checks for them by name.
FROM alpine:latest

RUN apk add --no-cache tmux git procps bash

# The repository, copied in exactly as a user would have it checked out.
# Last, so editing canopy does not invalidate the package layer.
COPY . /canopy

# How a user puts canopy on their PATH. Deliberately not a symlink into
# /usr/local/bin: canopy derives its store from "$(dirname "$0")/..", so a
# symlinked entry would resolve the store to /usr/local.
ENV PATH="/canopy/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

CMD ["/canopy/test/smoke/scenarios.sh"]
