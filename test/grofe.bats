#!/usr/bin/env bats
load helper

# `canopy grofe`: the grofe backend. grofe reads TOML layers, and canopy owns
# only its own conf.d fragments, one per template in grofe/templates/.
#
# What is being protected: that the fragments say what the tmux layers say,
# from the same data (tmux/keys.tsv, tmux/options.tsv), so the two backends
# cannot drift; that the checked-in grofe/conf.d is what the generator
# writes now; and that validation is grofe's own verdict, not a guess read
# out of error text.
setup() {
  setup_canopy_env
  setup_canopy_home
  . "$CANOPY_STORE/lib/env.sh"
  . "$CANOPY_STORE/lib/grofe.sh"
  canopy_paths
  out="$BATS_TEST_TMPDIR/conf.d"
}

# grofe is not a dependency of the suite: a test that needs the binary says
# so and is skipped where there is none. $CANOPY_GROFE names one.
need_grofe() {
  command -v "${CANOPY_GROFE:-grofe}" >/dev/null 2>&1 || skip "no grofe binary"
}

# grep that must not match. A bare `! grep` is not checked by bats except
# on a test's last line; a function's status is.
absent() {
  ! grep "$@"
}

@test "one fragment per template, under the same name" {
  run canopy-grofe generate --out "$out"
  [ "$status" -eq 0 ]
  templates="$(cd "$CANOPY_STORE/grofe/templates" && ls)"
  written="$(cd "$out" && ls)"
  [ "$templates" = "$written" ]
  for f in "$out"/*.toml; do
    head -1 "$f" | grep -q '^# Generated by `canopy grofe generate`'
  done
}

@test "the checked-in grofe/conf.d is what the generator writes now" {
  canopy-grofe generate --out "$out"
  run diff -ru "$CANOPY_STORE/grofe/conf.d" "$out"
  [ "$status" -eq 0 ]
}

@test "without --out it writes grofe's own conf.d, under XDG_CONFIG_HOME" {
  run canopy-grofe generate
  [ "$status" -eq 0 ]
  [ -f "$XDG_CONFIG_HOME/grofe/conf.d/10-canopy-keys.toml" ]
}

@test "every key table row is a binding with its name, group and description" {
  canopy-grofe generate --out "$out"
  keys="$out/10-canopy-keys.toml"
  grep -qxF 'h = { cmd = "select-pane -L", desc = "Focus the pane to the left", group = "pane", name = "pane-left" }' "$keys"
  grep -qxF 'H = { cmd = "resize-pane -L 5", desc = "Grow the pane leftwards, repeatable", group = "pane", name = "pane-wider-left", repeat = true }' "$keys"
  # A key TOML cannot take bare is quoted; a command holding double quotes
  # is a literal string, so it reaches grofe byte for byte.
  grep -qF '"|" = { cmd = '\''split-window -h -c "#{pane_current_path}"'\''' "$keys"
  # Every row, counted as the generator counts: blank rows and comments
  # skipped.
  rows="$(awk '!/^#/ && NF { n++ } END { print n + 0 }' "$CANOPY_STORE/tmux/keys.tsv")"
  bound="$(grep -c ' = { cmd = ' "$keys")"
  [ "$bound" -eq "$rows" ]
}

@test "a semicolon stays grofe's command separator, not an argument" {
  canopy-grofe generate --out "$out"
  grep -qF "; select-layout main-vertical ; select-pane -t 1'" "$out/10-canopy-keys.toml"
  absent -qF '\;' "$out/10-canopy-keys.toml"
}

@test "canopy-reload runs grofe's reload, not source-file" {
  canopy-grofe generate --out "$out"
  grep -qF "r = { cmd = 'reload ; display-message \"canopy: reloaded\"'" "$out/10-canopy-keys.toml"
  absent -q 'source-file' "$out/10-canopy-keys.toml"
}

@test "save-now and restore-now run the vendored resurrect scripts, as on tmux" {
  canopy-grofe generate --out "$out"
  grep -qF "M-s = { cmd = 'run-shell \"\$CANOPY_STORE/plugins/tmux-resurrect/scripts/save.sh\"'," "$out/10-canopy-keys.toml"
  grep -qF "M-r = { cmd = 'run-shell \"\$CANOPY_STORE/plugins/tmux-resurrect/scripts/restore.sh\"'," "$out/10-canopy-keys.toml"
  grep -q 'name = "save-now"' "$out/10-canopy-keys.toml"
  grep -q 'name = "restore-now"' "$out/10-canopy-keys.toml"
  absent -q "is not bound on grofe" "$out/10-canopy-keys.toml"
}

@test "an override naming no key table row is refused, and nothing is written" {
  store_copy="$BATS_TEST_TMPDIR/store"
  cp -R "$CANOPY_STORE" "$store_copy"
  printf 'no-such-row\t-\tstale\n' >>"$store_copy/grofe/keys.tsv"
  CANOPY_STORE="$store_copy" run "$store_copy/bin/canopy-grofe" generate --out "$out"
  [ "$status" -eq 1 ]
  [[ "$output" == *"no-such-row"* ]]
  [ -z "$(ls -A "$out" 2>/dev/null)" ]
}

@test "a canopy fragment whose template is gone is removed, and nothing else" {
  mkdir -p "$out"
  printf 'prefix = "C-a"\n' >"$out/40-canopy-gone.toml"
  printf 'prefix = "C-a"\n' >"$out/50-mine.toml"
  canopy-grofe generate --out "$out"
  [ ! -e "$out/40-canopy-gone.toml" ]
  [ -f "$out/50-mine.toml" ]
}

@test "the themes, pills and switches are options.tsv's defaults" {
  # The same cross-check config.bats makes for the tmux layers: a value
  # changed in one backend and not the other is a failing test.
  canopy-grofe generate --out "$out"
  run awk -F'\t' '
    FNR == 1 { file++ }
    file == 1 && !/^#/ && NF >= 3 && $3 == "layer" {
      d = $2
      if (d == "-") d = ""
      want[substr($1, 2)] = d
      next
    }
    file > 1 && /^\[/ { inside = ($0 == "[user-options]") ; next }
    file > 1 && inside && /^[a-z_-]+ = "/ {
      name = $0; sub(/ = .*/, "", name)
      value = $0; sub(/^[^"]*"/, "", value); sub(/"$/, "", value)
      seen++
      if (!(name in want)) { printf "%s is not in options.tsv\n", name; bad = 1 }
      else if (want[name] != value) { printf "%s: %s, options.tsv says %s\n", name, value, want[name]; bad = 1 }
    }
    END { if (!seen) { print "no user options read"; bad = 1 } exit bad }
  ' "$CANOPY_STORE/tmux/options.tsv" "$out/00-canopy-core.toml" "$out/20-canopy-status.toml" "$out/30-canopy-plugins.toml"
  [ "$status" -eq 0 ] || { printf '%s\n' "$output"; false; }
}

# A copy of the store to break things in.
store_copy() {
  store="$BATS_TEST_TMPDIR/store"
  cp -R "$CANOPY_STORE" "$store"
}

@test "a key table saved with CRLF line endings generates the same fragment" {
  canopy-grofe generate --out "$out"
  store_copy
  awk '{ printf "%s\r\n", $0 }' "$CANOPY_STORE/tmux/keys.tsv" >"$store/tmux/keys.tsv"
  awk '{ printf "%s\r\n", $0 }' "$CANOPY_STORE/grofe/keys.tsv" >"$store/grofe/keys.tsv"
  CANOPY_STORE="$store" run "$store/bin/canopy-grofe" generate --out "$BATS_TEST_TMPDIR/crlf"
  [ "$status" -eq 0 ]
  cmp "$out/10-canopy-keys.toml" "$BATS_TEST_TMPDIR/crlf/10-canopy-keys.toml"
}

@test "a control character in a column is refused, and nothing is written" {
  store_copy
  printf 'bell\tX\t-\tdisplay-message "\a"\tmisc\tRings\n' >>"$store/tmux/keys.tsv"
  CANOPY_STORE="$store" run "$store/bin/canopy-grofe" generate --out "$out"
  [ "$status" -eq 1 ]
  [[ "$output" == *"control character"* ]]
  [ -z "$(ls -A "$out" 2>/dev/null)" ]
}

@test "a command holding both quote kinds becomes an escaped basic string grofe reads" {
  store_copy
  printf 'both-quotes\tX\t-\tdisplay-message "it'"'"'s \\\\ here"\tmisc\tBoth quotes\n' >>"$store/tmux/keys.tsv"
  CANOPY_STORE="$store" run "$store/bin/canopy-grofe" generate --out "$out"
  [ "$status" -eq 0 ]
  grep -qxF 'X = { cmd = "display-message \"it'"'"'s \\\\ here\"", desc = "Both quotes", group = "misc", name = "both-quotes" }' "$out/10-canopy-keys.toml"
  need_grofe
  run "${CANOPY_GROFE:-grofe}" show-config --file "$out/10-canopy-keys.toml" keys.prefix.X
  [ "$status" -eq 0 ]
  [[ "$output" == *"it's"* ]]
}

@test "generate refuses a fragment grofe cannot load, and leaves conf.d as it was" {
  need_grofe
  canopy-grofe generate --out "$out"
  before="$(cat "$out"/*.toml | cksum)"
  store_copy
  printf 'stauts.left = "x"\n' >>"$store/grofe/templates/00-canopy-core.toml"
  CANOPY_STORE="$store" run "$store/bin/canopy-grofe" generate --out "$out"
  [ "$status" -eq 1 ]
  [[ "$output" == *"00-canopy-core.toml"* ]]
  [[ "$output" == *"nothing was written"* ]]
  [ "$(cat "$out"/*.toml | cksum)" = "$before" ]
  [ -z "$(ls -A "$out" | grep -v '^[0-9][0-9]-canopy-')" ]
}

@test "without a grofe to ask, generate writes and says the fragments are unchecked" {
  CANOPY_GROFE=/nonexistent/grofe run canopy-grofe generate --out "$out"
  [ "$status" -eq 0 ]
  [[ "$output" == *"written unchecked"* ]]
  [ -f "$out/10-canopy-keys.toml" ]
}

@test "both pill glyphs are byte-for-byte intact in the status fragment" {
  canopy-grofe generate --out "$out"
  run od -An -tx1 "$out/20-canopy-status.toml"
  [[ "${output//[[:space:]]/}" == *"ee82b6"* ]]
  [[ "${output//[[:space:]]/}" == *"ee82b4"* ]]
}

@test "the plugin layer sets every resurrect and continuum option 30-plugins.conf sets, to its value" {
  canopy-grofe generate --out "$out"
  plugins="$out/30-canopy-plugins.toml"
  run awk '
    FNR == 1 { file++ }
    # tmux: set -g @name value, the value quoted either way or not at all.
    file == 1 && /^set -g @(resurrect|continuum)-/ {
      name = $3
      value = $0
      sub(/^set -g @[^ ]+ /, "", value)
      if (value ~ /^".*"$/ || value ~ /^\047.*\047$/) value = substr(value, 2, length(value) - 2)
      want[substr(name, 2)] = value
      next
    }
    file == 2 && /^\[/ { inside = ($0 == "[user-options]"); next }
    file == 2 && inside && /^[a-z-]+ = "/ {
      name = $1
      value = $0
      sub(/^[^"]*"/, "", value)
      sub(/"$/, "", value)
      got[name] = value
    }
    # A path the tmux layer expands, set by a load command that grofe expands.
    file == 2 && /^  \047set-option -g @/ {
      line = $0
      sub(/^  \047set-option -g @/, "", line)
      name = line
      sub(/ .*/, "", name)
      value = line
      sub(/^[^"]*"/, "", value)
      sub(/"\047,$/, "", value)
      got[name] = value
    }
    END {
      for (n in want) {
        seen++
        if (!(n in got)) { printf "%s is not set\n", n; bad = 1 }
        else if (got[n] != want[n]) { printf "%s: [%s], 30-plugins.conf says [%s]\n", n, got[n], want[n]; bad = 1 }
      }
      if (seen != 7) { printf "read %d options from 30-plugins.conf, want 7\n", seen; bad = 1 }
      exit bad
    }
  ' "$CANOPY_STORE/tmux/conf.d/30-plugins.conf" "$plugins"
  [ "$status" -eq 0 ] || { printf '%s\n' "$output"; false; }
}

@test "the plugin layer loads the plugins through the loader, after the restore process list" {
  canopy-grofe generate --out "$out"
  plugins="$out/30-canopy-plugins.toml"
  grep -v '^ *#' "$plugins" >"$BATS_TEST_TMPDIR/body"
  # In load-commands, in this order: the process list, the loader over the
  # plugin list, and prefix C-s taken back from opensessions.
  run grep -n 'canopy_restore_processes.sh\|canopy_load_plugins\|bind-key C-s send-prefix' "$BATS_TEST_TMPDIR/body"
  [ "${#lines[@]}" -eq 3 ]
  [[ "${lines[0]}" == *'"""if-shell '*canopy_restore_processes.sh* ]]
  [[ "${lines[1]}" == *"canopy_load_plugins tmux-resurrect tmux-continuum "* ]]
  [[ "${lines[2]}" == *'"bind-key C-s send-prefix",' ]]
  # No plugin is named by its own path: the loader finds the entry points.
  absent -qF -e resurrect.tmux -e continuum.tmux "$BATS_TEST_TMPDIR/body"
}

@test "validate: the generated tree loads in grofe with no errors" {
  need_grofe
  canopy-grofe generate --out "$out"
  run canopy-grofe validate "$out"
  [ "$status" -eq 0 ]
  [ -z "$output" ]
  run canopy-grofe validate
  [ "$status" -eq 0 ]
}

@test "validate: each fragment loads on its own" {
  need_grofe
  canopy-grofe generate --out "$out"
  for f in "$out"/*.toml; do
    one="$BATS_TEST_TMPDIR/one-${f##*/}"
    mkdir -p "$one"
    cp "$f" "$one/"
    canopy_grofe_validate "$one"
  done
}

@test "validate: a broken fragment fails, with grofe's error naming it" {
  need_grofe
  canopy-grofe generate --out "$out"
  printf 'stauts.left = "x"\n' >"$out/90-broken.toml"
  run canopy-grofe validate "$out"
  [ "$status" -eq 1 ]
  [[ "$output" == *"90-broken.toml"* ]]
  [[ "$output" == *"did you mean status.left"* ]]
}

@test "validate: a fragment grofe skips for its requires header fails too" {
  need_grofe
  canopy-grofe generate --out "$out"
  printf 'requires = "grofe >= 999.0"\nprefix = "C-a"\n' >"$out/90-newer.toml"
  run canopy-grofe validate "$out"
  [ "$status" -eq 1 ]
  [[ "$output" == *"skipped"* ]]
}

@test "validate: a user file loads last, after the fragments" {
  need_grofe
  canopy-grofe generate --out "$out"
  printf '[keys.prefix]\nK = "run-shell true"\n' >"$BATS_TEST_TMPDIR/user.toml"
  run canopy-grofe validate --user "$BATS_TEST_TMPDIR/user.toml" "$out"
  [ "$status" -eq 0 ]
  printf '[keys.prefix]\nK = "no-such-command"\n' >"$BATS_TEST_TMPDIR/user.toml"
  run canopy-grofe validate --user "$BATS_TEST_TMPDIR/user.toml" "$out"
  [ "$status" -eq 1 ]
  [[ "$output" == *"user.toml"* ]]
}

@test "validate: no grofe on PATH is an error, not a pass" {
  CANOPY_GROFE=/nonexistent/grofe run canopy-grofe validate
  [ "$status" -eq 1 ]
  [[ "$output" == *"not found"* ]]
}

@test "an unknown subcommand or argument is refused" {
  run canopy-grofe frobnicate
  [ "$status" -eq 1 ]
  run canopy-grofe generate --bogus
  [ "$status" -eq 1 ]
}
