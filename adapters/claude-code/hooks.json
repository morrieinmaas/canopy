{
  "SessionStart": [
    { "hooks": [ { "type": "command", "command": "\"{report}\" idle" } ] }
  ],
  "UserPromptSubmit": [
    { "hooks": [ { "type": "command", "command": "\"{report}\" working" } ] }
  ],
  "PreToolUse": [
    { "hooks": [ { "type": "command", "command": "\"{report}\" working" } ] }
  ],
  "PostToolUse": [
    { "hooks": [ { "type": "command", "command": "\"{report}\" working" } ] }
  ],
  "Notification": [
    { "matcher": "permission_prompt", "hooks": [ { "type": "command", "command": "\"{report}\" blocked" } ] },
    { "matcher": "idle_prompt", "hooks": [ { "type": "command", "command": "\"{report}\" completed" } ] }
  ],
  "Stop": [
    { "hooks": [ { "type": "command", "command": "\"{report}\" completed" } ] }
  ],
  "SessionEnd": [
    { "hooks": [ { "type": "command", "command": "\"{report}\" exited" } ] }
  ]
}
