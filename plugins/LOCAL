# Files written into a vendored tree after vendoring. The tree digest
# (lib/plugins.sh, canopy_plugin_digest) leaves these out, so a tree a
# plugin has run in, or canopy install has provisioned, still matches its
# CHECKSUMS line. <name> <path relative to plugins/<name>> [<copied from>]
#
# canopy install, from plugins/ARTIFACTS; doctor checks each against its
# own sha256 there.
opensessions bin/opensessions-sidebar
opensessions bin/opensessions-server
opensessions bin/lazydiff
opensessions bin/.opensessions-version
tmux-fzf-url bin/xre
# tmux-which-key, on its first load, with autobuild off: its config and
# the menu it loads, each a copy of the file in the third column, which
# doctor compares them with.
tmux-which-key config.yaml config.example.yaml
tmux-which-key plugin/init.tmux plugin/init.example.tmux
