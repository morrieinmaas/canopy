#!/bin/sh
# canopy:summary=Render the status line's right-hand segments
# canopy:group=core
# canopy:args=[--plain]
# canopy:examples=canopy status
# shellcheck disable=SC2154,SC2153  # CANOPY_STORE is exported by lib/env.sh's canopy_paths
set -eu

: "${CANOPY_STORE:=$(cd "$(dirname "$0")/.." && pwd)}"
# shellcheck source=../lib/env.sh
# shellcheck disable=SC1091
. "$CANOPY_STORE/lib/env.sh"
canopy_paths

# The one aggregator the status line is allowed, per spec 4.3 and section
# 6: a status line that forks per segment per redraw is a defect rather
# than a style choice. Four segments rendered by four `#()` calls is four
# processes every status-interval, forever, on every machine. This is one,
# and everything it needs from tmux it reads in a single call.
#
# Everything else in the status line is a pure `#{...}` token, which costs
# nothing at all.
#
# Segments render right to left as: network, battery, date, clock. A
# segment with nothing to say prints nothing, so its pill disappears
# rather than showing a placeholder.

canopy_status_plain=0
for canopy_status_arg in "$@"; do
  case "$canopy_status_arg" in
    --plain) canopy_status_plain=1 ;;
    *) canopy_die "canopy-status: unknown argument: $canopy_status_arg" ;;
  esac
done

# One tmux call for every option this needs. Asking per segment would put
# a fork per segment back in, by a different route.
canopy_status_read_options() {
  tmux display-message -p \
    '#{@theme_bg}|#{@theme_fg}|#{@theme_blue}|#{@theme_green}|#{@theme_grey}|#{@theme_red}|#{@pill_l}|#{@pill_r}|#{@canopy_status_battery}|#{@canopy_status_net}' \
    2>/dev/null || printf '|||||||||\n'
}

# Split with the shell, not with ten pipelines into cut. Each of those was
# two processes, twenty in total, to take apart a string this script is
# already holding, in a script whose entire reason for existing is that a
# fork per segment per redraw is a defect. read splits it in one go.
# shellcheck disable=SC2034  # fg is read to keep the fields lined up with the format string, not used here
canopy_status_split() {
  IFS='|' read -r canopy_status_bg canopy_status_fg canopy_status_blue \
    canopy_status_green canopy_status_grey canopy_status_red \
    canopy_status_pill_l canopy_status_pill_r \
    canopy_status_want_batt canopy_status_want_net <<EOF
$1
EOF
}

# pill <colour> <text>
# A segment as a rounded pill: a left cap and a right cap in the segment's
# colour on the terminal's own background, with the text reversed out of
# it. With --plain, or where the caps are unset because no font has them,
# the same text with no caps at all.
canopy_status_pill() {
  if [ "$canopy_status_plain" -eq 1 ] || [ -z "$canopy_status_pill_l" ]; then
    printf '%s ' "$2"
    return 0
  fi
  printf '#[fg=%s,bg=default]%s#[fg=%s,bg=%s,bold] %s #[fg=%s,bg=default,nobold]%s ' \
    "$1" "$canopy_status_pill_l" "$canopy_status_bg" "$1" "$2" "$1" "$canopy_status_pill_r"
}

# --- battery ---------------------------------------------------------------
# Prints a percentage and, when charging, a leading +. Prints nothing at
# all on a machine with no battery, which is most servers and every
# container, so the pill is absent rather than empty.
canopy_status_battery() {
  canopy_status_pct=""
  canopy_status_charging=0
  if [ "$canopy_status_uname" = Darwin ]; then
    canopy_status_batt="$(pmset -g batt 2>/dev/null)" || return 0
    case "$canopy_status_batt" in
      *InternalBattery*) ;;
      *) return 0 ;;
    esac
    canopy_status_pct="$(printf '%s\n' "$canopy_status_batt" |
      grep -o '[0-9]\{1,3\}%' | head -1 | tr -d '%')"
    case "$canopy_status_batt" in
      *" charging"* | *"AC Power"* | *charged* | *"finishing charge"*)
        canopy_status_charging=1
        ;;
      *) ;;
    esac
  else
    for canopy_status_b in /sys/class/power_supply/BAT*; do
      [ -r "$canopy_status_b/capacity" ] || continue
      canopy_status_pct="$(cat "$canopy_status_b/capacity" 2>/dev/null)" || canopy_status_pct=""
      # "Not charging" is Linux for plugged in and deliberately not
      # charging, which a charge threshold does on purpose. Counting it as
      # charging rendered a battery sitting at 45 percent as a green +45%.
      case "$(cat "$canopy_status_b/status" 2>/dev/null)" in
        Charging | Full) canopy_status_charging=1 ;;
        *) ;;
      esac
      break
    done
  fi

  case "$canopy_status_pct" in
    '' | *[!0-9]*) return 0 ;;
    *) ;;
  esac

  # Red below fifteen. The threshold is the only judgement here, and it is
  # the one a person actually acts on.
  if [ "$canopy_status_charging" -eq 1 ]; then
    canopy_status_pill "$canopy_status_green" "+$canopy_status_pct%"
  elif [ "$canopy_status_pct" -le 15 ]; then
    canopy_status_pill "$canopy_status_red" "$canopy_status_pct%"
  else
    canopy_status_pill "$canopy_status_blue" "$canopy_status_pct%"
  fi
}

# --- network ---------------------------------------------------------------
# The interface carrying the default route, and whether a tunnel is up.
#
# Deliberately vendor neutral. It reports that traffic leaves through en0
# or wlan0, and that some tunnel interface exists, without naming a VPN
# product: a distribution that hardcodes one person's provider is a
# distribution nobody else's machine describes correctly. A setup with
# something specific to say says it in user.conf, appended with
# `set -ag status-right`.
canopy_status_net() {
  canopy_status_iface=""
  if [ "$canopy_status_uname" = Darwin ]; then
    canopy_status_iface="$(route -n get default 2>/dev/null |
      awk '/interface:/ { print $2; exit }')" || canopy_status_iface=""
  else
    canopy_status_iface="$(ip route show default 2>/dev/null |
      awk '/^default/ { for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit } }')" ||
      canopy_status_iface=""
  fi

  [ -n "$canopy_status_iface" ] || {
    canopy_status_pill "$canopy_status_red" "offline"
    return 0
  }

  case "$canopy_status_iface" in
    utun* | tun* | wg* | tailscale*)
      canopy_status_pill "$canopy_status_green" "$canopy_status_iface"
      ;;
    *) canopy_status_pill "$canopy_status_grey" "$canopy_status_iface" ;;
  esac
}

# --- render ----------------------------------------------------------------

canopy_status_split "$(canopy_status_read_options)"

# Asked once, not once per segment.
canopy_status_uname="$(uname)"

# Unset means on. A machine that has never set these should get the
# status line the distribution ships, and a person who wants a segment
# gone says so once.
[ -n "$canopy_status_bg" ] || canopy_status_bg="default"
[ -n "$canopy_status_blue" ] || canopy_status_blue="blue"
[ -n "$canopy_status_green" ] || canopy_status_green="green"
[ -n "$canopy_status_grey" ] || canopy_status_grey="colour245"
[ -n "$canopy_status_red" ] || canopy_status_red="red"

[ "$canopy_status_want_net" = "off" ] || canopy_status_net
[ "$canopy_status_want_batt" = "off" ] || canopy_status_battery
canopy_status_pill "$canopy_status_grey" "$(date '+%a %d %b')"
canopy_status_pill "$canopy_status_green" "$(date '+%H:%M')"
printf '\n'
