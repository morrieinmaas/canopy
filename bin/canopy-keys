#!/bin/sh
# canopy:summary=Generate the key layer from the key table
# canopy:group=core
# canopy:args=[--print]
# canopy:examples=canopy keys --print
# shellcheck disable=SC2154,SC2153  # CANOPY_STORE/CANOPY_STATE are exported by lib/env.sh's canopy_paths
set -eu

: "${CANOPY_STORE:=$(cd "$(dirname "$0")/.." && pwd)}"
# shellcheck source=../lib/env.sh
# shellcheck disable=SC1091
. "$CANOPY_STORE/lib/env.sh"
canopy_paths

# Keys are data, and this is the only thing that turns that data into
# bindings. Spec 4.4: one table declares every binding canopy ships, and
# the same table feeds the palette, the which-key menu and the cheatsheet
# when those arrive. A binding written as a bind line anywhere else has no
# description and no group, so it can never appear in any of them, and the
# table quietly stops being the truth.
#
# Written to CANOPY_STATE rather than into the store's conf.d, for the same
# reason 05-caps.conf is: the store is read-only by convention, and a
# generated file inside a git checkout is a file that shows up as a local
# modification on every machine.

canopy_keys_print=0
for canopy_keys_arg in "$@"; do
  case "$canopy_keys_arg" in
    --print) canopy_keys_print=1 ;;
    *) canopy_die "canopy-keys: unknown argument: $canopy_keys_arg" ;;
  esac
done

canopy_keys_table="$CANOPY_STORE/tmux/keys.tsv"
[ -f "$canopy_keys_table" ] ||
  canopy_die "canopy-keys: no key table at $canopy_keys_table"

if [ "$canopy_keys_print" -eq 1 ]; then
  awk -F'\t' '
    /^#/ { next }
    NF == 0 { next }
    {
      if ($5 != group) {
        if (group != "") printf "\n"
        group = $5
        printf "%s:\n", group
      }
      printf "  %-4s %-18s %s\n", $2, $1, $6
    }
  ' "$canopy_keys_table"
  exit 0
fi

canopy_keys_out="$CANOPY_STATE/10-keys.conf"
mkdir -p "$CANOPY_STATE"
# Beside the target, not in the runtime dir. CANOPY_RUNTIME is a tmpfs on
# Linux while CANOPY_STATE is under $HOME, and `mv` across filesystems is
# copy-then-unlink, so a tmux sourcing the layer mid-write could read a
# half-written file: exactly what moving it into place is meant to
# prevent. canopy-caps already does it this way.
canopy_keys_tmp="$canopy_keys_out.tmp.$$"
trap 'rm -f "$canopy_keys_tmp"' EXIT

# A malformed row is refused rather than emitted. tmux would take a
# half-written bind line and either fail the whole layer or, worse, bind
# something nobody declared.
awk -F'\t' '
  /^#/ { next }
  NF == 0 { next }
  NF != 6 {
    printf "canopy-keys: %s line %d: expected 6 tab separated columns, got %d\n", FILENAME, NR, NF > "/dev/stderr"
    bad = 1
    next
  }
  $1 == "" || $2 == "" || $3 == "" || $4 == "" || $5 == "" || $6 == "" {
    printf "canopy-keys: %s line %d: every column must be filled\n", FILENAME, NR > "/dev/stderr"
    bad = 1
    next
  }
  {
    if (seen_key[$2]++) {
      printf "canopy-keys: %s line %d: key %s is declared twice\n", FILENAME, NR, $2 > "/dev/stderr"
      bad = 1
      next
    }
    if (seen_name[$1]++) {
      printf "canopy-keys: %s line %d: name %s is declared twice\n", FILENAME, NR, $1 > "/dev/stderr"
      bad = 1
      next
    }
    rows[++n] = $0
  }
  END {
    if (bad) exit 1
    print "# Generated by `canopy keys` from tmux/keys.tsv. Do not edit."
    print "#"
    print "# Every binding canopy ships is declared in that table, with a name, a"
    print "# group and a description, so that one file answers both what a key does"
    print "# and what to tell somebody about it. Edit the table, then run"
    print "# `canopy keys`."
    print ""
    for (i = 1; i <= n; i++) {
      split(rows[i], f, "\t")
      # A semicolon in the table means what it means to tmux, a command
      # separator, so it is emitted unquoted and spaced. Written any other
      # way the whole tail arrives as arguments to the first command.
      cmd = f[4]
      gsub(/ ; /, " \\; ", cmd)
      if (f[3] == "-")
        printf "bind %s %s\n", f[2], cmd
      else
        printf "bind %s %s %s\n", f[3], f[2], cmd
    }
  }
' "$canopy_keys_table" >"$canopy_keys_tmp" || {
  rm -f "$canopy_keys_tmp"
  canopy_die "canopy-keys: the key table has errors, nothing was written"
}

# Moved into place rather than written in place, so a tmux sourcing the
# layer never sees a half-written file.
mv "$canopy_keys_tmp" "$canopy_keys_out"
