#!/bin/sh
# canopy:summary=Say which machine and scope this is, and follow the laptop's theme
# canopy:group=core
# canopy:args=set --machine <name> --scope <scope> --color <colour> | clear | follow-theme <session>
# canopy:examples=canopy remote set --machine acme-dev --scope work/acme --color yellow
# shellcheck disable=SC2154,SC2153  # CANOPY_STATE is exported by lib/env.sh's canopy_paths
set -eu

: "${CANOPY_STORE:=$(cd "$(dirname "$0")/.." && pwd)}"
# shellcheck source=../lib/env.sh
# shellcheck disable=SC1091
. "$CANOPY_STORE/lib/env.sh"
canopy_paths

# A remote machine's per-machine layer, one file per backend, written the way
# canopy caps writes 05-caps.conf. The shipped layers stay the same on every
# machine; these two are what makes a box say where it is. On a laptop
# neither exists, and nothing here changes anything.
#
# athome runs `set` on a box, with flags rather than its ATHOME_* variables,
# so it never depends on which environment it runs in.

remote_tmux="$CANOPY_STATE/25-remote.conf"
# Outside the NN-canopy-*.toml names `canopy grofe generate` owns and cleans
# up, and after 20-canopy-status.toml in grofe's lexical load order.
remote_grofe="${XDG_CONFIG_HOME:-$HOME/.config}/grofe/conf.d/25-remote.toml"

remote_usage() {
  canopy_die "usage: canopy remote set --machine <name> --scope <scope> --color <colour> | clear"
}

# Spelled out rather than A-Za-z0-9: a range is read by the locale, and
# under some shells and locales it matches letters outside ASCII.
remote_alnum=abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789

# Values are checked rather than escaped: they land inside a tmux config and
# a TOML file, and a name that needs quoting is not a machine name.
remote_check() {
  case "$2" in
    '' | [!"$remote_alnum"]* | *[!"$remote_alnum"._"$3"-]*)
      canopy_die "canopy-remote: $1 must start with a letter or digit and hold only $4, got: $2"
      ;;
    *) ;;
  esac
}

# The terminal's own 16 colours, by tmux's names. athome's prompt uses the
# same name, and a palette colour is what makes the two match on any theme.
remote_check_color() {
  case "$1" in
    black | red | green | yellow | blue | magenta | cyan | white) ;;
    brightblack | brightred | brightgreen | brightyellow) ;;
    brightblue | brightmagenta | brightcyan | brightwhite) ;;
    *) canopy_die "canopy-remote: --color must be one of the 16 ANSI colour names (yellow, brightred, ...), got: $1" ;;
  esac
}

# The hook command, the same on both backends. Single quotes so the shell
# the job runs in expands $CANOPY_STORE from the server's environment, as the
# plugin loader's run-shell does; #{q:session_name} so a session name with a
# space or a quote is still one argument.
remote_hook_cmd="run-shell -b '\"\$CANOPY_STORE/bin/canopy-remote\" follow-theme #{q:session_name}'"

remote_write_tmux() {
  cat <<EOF
# Generated by \`canopy remote set\`. Do not edit: run it again, or \`canopy remote clear\`.
set -g @canopy_machine "$1"
set -g @canopy_scope "$2"
set -g @canopy_context_color "$3"
set -g status-left-length 80
set -g set-titles on
set -g set-titles-string "#{@canopy_machine} · #S"
# A fixed index, so a reload does not list it twice and tmux's own entries stay.
set -g 'update-environment[90]' CANOPY_THEME
# Not client-session-changed: opensessions sets that hook with a plain
# set-hook, which clears every index of it. Real tmux only; on grofe the
# hook is in 25-remote.toml.
%if "#{==:#{grofe_version},}"
set-hook -g 'client-attached[90]' { $remote_hook_cmd }
set-hook -g 'after-new-session[90]' { $remote_hook_cmd }
%endif
EOF
}

remote_write_grofe() {
  cat <<EOF
# Generated by \`canopy remote set\`. Do not edit: run it again, or \`canopy remote clear\`.

requires = "grofe >= 0.1"

set-titles = true
set-titles-string = "#{@canopy_machine} · #{session_name}"

# A load command, not an update-environment array: an array would replace
# the whole list. A fixed index, so a reload does not list it twice.
load-commands = ['set-option -g "update-environment[90]" CANOPY_THEME']

[user-options]
canopy_machine = "$1"
canopy_scope = "$2"
canopy_context_color = "$3"

[status]
left-length = 80

# grofe fires it on every attach, the first one that creates a session
# included, and on switch-client.
[hooks]
client-session-changed = """$remote_hook_cmd"""
EOF
}

# Both files are rendered to temporary names beside them first, and only
# then moved into place, so a reader never sees half a file. Two renames
# cannot be one, so if the second fails both files are removed: a box then
# shows no indicator on either backend, never old values on one of them.
remote_put_both() {
  for remote_f in "$remote_tmux" "$remote_grofe"; do
    [ ! -d "$remote_f" ] || canopy_die "canopy-remote: $remote_f is a directory, nothing was written"
  done
  remote_tmp_t="$remote_tmux.tmp.$$"
  remote_tmp_g="$remote_grofe.tmp.$$"
  mkdir -p "${remote_tmux%/*}" "${remote_grofe%/*}" 2>/dev/null ||
    canopy_die "canopy-remote: could not create ${remote_tmux%/*} or ${remote_grofe%/*}, nothing was written"
  # After the mkdir: with no directory to hold them, BSD rm complains about
  # temporary files that were never made.
  trap 'rm -f "$remote_tmp_t" "$remote_tmp_g"' EXIT
  remote_write_tmux "$@" >"$remote_tmp_t"
  remote_write_grofe "$@" >"$remote_tmp_g"
  mv "$remote_tmp_t" "$remote_tmux"
  if ! mv "$remote_tmp_g" "$remote_grofe"; then
    rm -f "$remote_tmux" "$remote_grofe"
    canopy_die "canopy-remote: could not write $remote_grofe; removed both remote files"
  fi
  trap - EXIT
}

remote_set() {
  machine=""
  scope=""
  color=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --machine | --scope | --color)
        [ "$#" -ge 2 ] || remote_usage
        case "$1" in
          --machine) machine="$2" ;;
          --scope) scope="$2" ;;
          *) color="$2" ;;
        esac
        shift 2
        ;;
      *) canopy_die "canopy-remote: unknown argument: $1" ;;
    esac
  done
  [ -n "$machine" ] && [ -n "$scope" ] && [ -n "$color" ] || remote_usage
  remote_check --machine "$machine" "" "letters, digits, '.', '_' and '-'"
  remote_check --scope "$scope" / "letters, digits, '.', '_', '-' and '/'"
  remote_check_color "$color"

  remote_put_both "$machine" "$scope" "$color"
}

remote_clear() {
  [ "$#" -eq 0 ] || canopy_die "canopy-remote: unknown argument: $1"
  rm -f "$remote_tmux" "$remote_grofe"
}

# follow-theme <session>: the hooks' entry point. The laptop's athome theme
# name arrives as CANOPY_THEME in the client's environment, and
# update-environment copies it into the session, so that is where it is
# read: a job runs with the server's environment, where it would be stale.
# It is applied with athome's own `theme`, and only when that knows the
# name and it is not already the one in use. A hook has nobody to report
# to, so every other case is silence and exit 0.
remote_follow_theme() {
  [ "$#" -eq 1 ] && [ -n "$1" ] ||
    canopy_die "usage: canopy remote follow-theme <session>"
  line="$(tmux show-environment -t "$1" CANOPY_THEME 2>/dev/null)" || return 0
  name="${line#CANOPY_THEME=}"
  [ "$name" != "$line" ] || return 0
  case "$name" in
    '' | *[!"$remote_alnum"._-]* | .* | -*) return 0 ;;
    *) ;;
  esac

  # A server started by a service manager may not have ~/.local/bin on its
  # PATH, which is where athome puts `theme`.
  theme_cmd="$(command -v theme 2>/dev/null)" || theme_cmd="$HOME/.local/bin/theme"
  [ -x "$theme_cmd" ] || return 0
  "$theme_cmd" --list 2>/dev/null | grep -qxF -e "$name" || return 0
  [ "$("$theme_cmd" --current 2>/dev/null)" != "$name" ] || return 0
  "$theme_cmd" "$name" >/dev/null 2>&1 || true
}

[ "$#" -gt 0 ] || remote_usage
remote_sub="$1"
shift
case "$remote_sub" in
  set) remote_set "$@" ;;
  clear) remote_clear "$@" ;;
  follow-theme) remote_follow_theme "$@" ;;
  *) remote_usage ;;
esac
