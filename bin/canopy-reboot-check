#!/bin/sh
# canopy:summary=Say which agent panes survive a reboot, and why the rest do not
# canopy:group=agent
# canopy:args=
# canopy:examples=canopy reboot-check
# shellcheck disable=SC2154,SC2153  # CANOPY_STATE is exported by lib/env.sh's canopy_paths
set -eu

: "${CANOPY_STORE:=$(cd "$(dirname "$0")/.." && pwd)}"
# shellcheck source=../lib/env.sh
# shellcheck disable=SC1091
. "$CANOPY_STORE/lib/env.sh"
# shellcheck source=../lib/adapter.sh
# shellcheck disable=SC1091
. "$CANOPY_STORE/lib/adapter.sh"
# shellcheck source=../lib/pane.sh
# shellcheck disable=SC1091
. "$CANOPY_STORE/lib/pane.sh"
# shellcheck source=../lib/resume.sh
# shellcheck disable=SC1091
. "$CANOPY_STORE/lib/resume.sh"
canopy_paths

[ "$#" -eq 0 ] || canopy_die "canopy-reboot-check: unknown argument: $1"

# Every verdict here is read off what resurrect actually saved, never off
# what canopy meant to save. A pre-flight that reports the intention rather
# than the file on disk is the one failure this command exists to prevent:
# it would say yes, and the user would find out after the reboot.

# continuum's own defaults, at the commit pinned in plugins/VERSIONS. They
# are repeated rather than read out of the vendored tree because the tree
# holds upstream bytes and canopy sources none of them, and because an
# unset option is the common case: reporting "unknown" for the machine
# nobody has configured would make this command useless on most machines.
canopy_rc_default_interval=15
canopy_rc_default_restore=off
canopy_rc_halt_file="${HOME-}/tmux_no_auto_restore"

canopy_rc_option() {
  canopy_rc_raw="$(tmux show -gqv "$1" 2>/dev/null)" || canopy_rc_raw=""
  printf '%s\n' "$canopy_rc_raw"
}

# canopy_rc_other_tmux_running
# True when continuum would decide that another tmux server is running.
#
# It is continuum's arithmetic, not a better one, because the point is to
# report the decision continuum will actually make: it counts this user's
# tmux processes, drops the current server by pid, and calls the rest
# another server when they outnumber the clients attached here. Counting
# more cleverly than continuum does would mean reporting a machine as fine
# that continuum will then refuse to restore.
canopy_rc_other_tmux_running() {
  canopy_rc_server_pid="$(tmux display-message -p '#{pid}' 2>/dev/null)" || return 1
  [ -n "$canopy_rc_server_pid" ] || return 1
  canopy_rc_clients="$(tmux list-clients 2>/dev/null | wc -l)" || return 1
  canopy_rc_others="$(ps -u "$(id -u)" -o command,pid 2>/dev/null |
    awk -v self="$canopy_rc_server_pid" '
      $1 !~ /^tmux/ { next }
      $1 == "tmux" && $2 == "source" { next }
      $NF == self { next }
      { n++ }
      END { print n + 0 }
    ')" || return 1
  [ "$canopy_rc_others" -gt "$canopy_rc_clients" ]
}

# canopy_rc_saved_command <session> <window index> <pane index>
# The command resurrect recorded for that pane in the last save, or a
# failure when the save does not have the pane at all. The file is tab
# delimited, one line per pane, and the command field carries a leading
# colon that resurrect adds so an empty command survives the round trip.
canopy_rc_saved_command() {
  [ -f "$canopy_rc_save_file" ] || return 1
  awk -F'\t' -v s="$1" -v w="$2" -v p="$3" '
    $1 == "pane" && $2 == s && $3 == w && $6 == p {
      command = $11
      sub(/^:/, "", command)
      print command
      found = 1
      exit
    }
    END { exit found ? 0 : 1 }
  ' "$canopy_rc_save_file"
}

printf 'canopy reboot-check\n'
printf '===================\n\n'

if ! tmux list-panes -a -F '#{pane_id}' >/dev/null 2>&1; then
  printf 'No tmux server is running, so a reboot has nothing to lose.\n'
  exit 0
fi

canopy_rc_tab="$(printf '\t')"
canopy_rc_newline='
'
canopy_rc_problems=""
canopy_rc_problem() {
  canopy_rc_problems="$canopy_rc_problems  $1$canopy_rc_newline"
}

# --- where the saves are ---------------------------------------------------
# Read from the option rather than assumed, because the option is what
# resurrect itself reads. A machine whose user pointed it elsewhere must be
# told about the saves it actually has.
canopy_rc_dir="$(canopy_rc_option @resurrect-dir)"
# Unset means resurrect's own default, not canopy's state directory.
#
# canopy's plugin layer sets @resurrect-dir, so on a machine running
# canopy the option is always there and this branch never runs. Where it
# does run is the one case that matters most for getting it right: a
# machine that has NOT switched yet, being asked what a reboot would cost
# before anything changes. Falling back to canopy's own directory there
# looked in a folder resurrect had never written to and reported every
# pane as "not saved yet", on a machine with a perfectly good save file
# sitting in resurrect's default location.
#
# The two branches are resurrect's, copied from its helpers.sh: the old
# ~/.tmux/resurrect when that directory exists, the XDG path otherwise.
if [ -z "$canopy_rc_dir" ]; then
  if [ -d "$HOME/.tmux/resurrect" ]; then
    canopy_rc_dir="$HOME/.tmux/resurrect"
  else
    canopy_rc_dir="${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect"
  fi
fi
canopy_rc_save_file="$canopy_rc_dir/last"

# --- whether anything reads the saves back ---------------------------------
# Answered before a single pane is judged, because it outranks every
# per-pane verdict. Autosave can be perfect, the save file can hold the
# right resume command for every pane, and none of it is worth anything
# when nothing replays the file at boot. continuum defaults
# @continuum-restore to off, and a stock install that left it there
# restored nothing at all while this command reported pane after pane as
# resuming. A confident yes about a disabled restore path is the one
# answer this command must never give.
canopy_rc_restore="$(canopy_rc_option @continuum-restore)"
[ -n "$canopy_rc_restore" ] || canopy_rc_restore="$canopy_rc_default_restore"
canopy_rc_restore_ok=1
canopy_rc_restore_why=""
if [ "$canopy_rc_restore" != "on" ]; then
  canopy_rc_restore_ok=0
  canopy_rc_restore_why="@continuum-restore is $canopy_rc_restore, not on, so nothing is restored when the server starts"
elif [ -f "$canopy_rc_halt_file" ]; then
  # continuum's own off switch, and it is off switch enough: its restore
  # script looks for this file before it does anything else.
  canopy_rc_restore_ok=0
  canopy_rc_restore_why="$canopy_rc_halt_file exists, and continuum restores nothing while it does"
fi

# --- the panes -------------------------------------------------------------
canopy_rc_total=0
canopy_rc_resuming=0
canopy_rc_report=""

while IFS="$canopy_rc_tab" read -r canopy_rc_pane canopy_rc_adapter; do
  [ -n "$canopy_rc_pane" ] || continue
  canopy_rc_info="$(tmux display-message -p -t "$canopy_rc_pane" \
    "#{session_name}$canopy_rc_tab#{window_index}$canopy_rc_tab#{pane_index}$canopy_rc_tab#{@canopy_agent_session}" \
    2>/dev/null)" || continue

  canopy_rc_session="${canopy_rc_info%%"$canopy_rc_tab"*}"
  canopy_rc_rest="${canopy_rc_info#*"$canopy_rc_tab"}"
  canopy_rc_window="${canopy_rc_rest%%"$canopy_rc_tab"*}"
  canopy_rc_rest="${canopy_rc_rest#*"$canopy_rc_tab"}"
  canopy_rc_index="${canopy_rc_rest%%"$canopy_rc_tab"*}"
  canopy_rc_id="${canopy_rc_rest#*"$canopy_rc_tab"}"

  # A pane restored from a save comes back running its own resume command
  # and carrying no pane options, because resurrect saves none. Reading
  # only the option made this command report "no session id has been
  # reported" about panes it had just correctly restored, which is the one
  # kind of answer it exists not to give. The id is still there, in the
  # command the pane is running.
  canopy_rc_recovered=0
  if [ -z "$canopy_rc_id" ]; then
    canopy_rc_id="$(canopy_adapter_id_from_command "$canopy_rc_adapter" \
      "$(canopy_pane_command "$canopy_rc_pane" 2>/dev/null)" 2>/dev/null)" ||
      canopy_rc_id=""
    [ -z "$canopy_rc_id" ] || canopy_rc_recovered=1
  fi

  canopy_rc_total=$((canopy_rc_total + 1))

  # shellcheck disable=SC2310  # every branch here asks a question, so a non-zero return is the answer and not a failure to abort on
  if [ "$canopy_rc_restore_ok" -eq 0 ]; then
    # Named per pane so the listing still says what is at risk, but never
    # as "will resume": with the restore path disabled, no pane comes back
    # however well it was saved.
    canopy_rc_verdict="will not be restored"
    canopy_rc_reason="the restore path is disabled, see below"
  elif [ -z "$canopy_rc_id" ]; then
    canopy_rc_verdict="will restart without its conversation"
    canopy_rc_reason="no session id has been reported for this pane"
  elif ! canopy_rc_resume="$(canopy_adapter_resume_command \
    "$canopy_rc_adapter" "$canopy_rc_id" 2>/dev/null)"; then
    canopy_rc_verdict="will restart without its conversation"
    canopy_rc_reason="the $canopy_rc_adapter adapter has no usable resume command"
  elif ! canopy_rc_saved="$(canopy_rc_saved_command \
    "$canopy_rc_session" "$canopy_rc_window" "$canopy_rc_index")"; then
    canopy_rc_verdict="not saved yet"
    canopy_rc_reason="the last save does not have this pane"
  elif [ "$(canopy_resume_stagger_strip "$canopy_rc_saved")" = "$canopy_rc_resume" ]; then
    canopy_rc_verdict="will resume"
    if [ "$canopy_rc_recovered" -eq 1 ]; then
      canopy_rc_reason="the last save resumes $canopy_rc_id, read from the command the pane is running"
    else
      canopy_rc_reason="the last save resumes $canopy_rc_id"
    fi
    canopy_rc_resuming=$((canopy_rc_resuming + 1))
  else
    canopy_rc_verdict="will restart without its conversation"
    canopy_rc_reason="the last save records: $canopy_rc_saved"
  fi

  canopy_rc_report="$canopy_rc_report  $canopy_rc_session:$canopy_rc_window.$canopy_rc_index  $canopy_rc_adapter: $canopy_rc_verdict, $canopy_rc_reason$canopy_rc_newline"
done <<EOF
$(canopy_pane_agent_panes)
EOF

printf 'Agent panes:\n'
if [ "$canopy_rc_total" -eq 0 ]; then
  printf '  no agent panes are open, so a reboot has no conversation to lose\n'
else
  printf '%s' "$canopy_rc_report"
fi
printf '\n'

# --- whether anything is being saved at all --------------------------------
canopy_rc_interval="$(canopy_rc_option @continuum-save-interval)"
[ -n "$canopy_rc_interval" ] || canopy_rc_interval="$canopy_rc_default_interval"
case "$canopy_rc_interval" in
  '' | *[!0-9]* | 0) canopy_rc_interval_ok=0 ;;
  *) canopy_rc_interval_ok=1 ;;
esac

printf 'Persistence:\n'

if [ "$canopy_rc_restore_ok" -eq 1 ]; then
  printf '  continuum restore at server start: on\n'
else
  printf '  continuum restore at server start: off\n'
  canopy_rc_problem "$canopy_rc_restore_why"
fi

# Not a problem, because it is not a misconfiguration and it is not
# permanent: continuum refuses to auto restore while another tmux server
# is running, and whether one is running at the next boot is a different
# question from whether one is running now. It is said out loud because
# this is exactly where a developer's machine stops behaving like CI, and
# a divergence nobody is told about is one nobody debugs.
# shellcheck disable=SC2310  # a state question, so its non-zero return is the answer and not a failure to abort on
if canopy_rc_other_tmux_running; then
  printf '  another tmux server is running, and continuum restores nothing while that is true at boot\n'
fi

if [ "$canopy_rc_interval_ok" -eq 0 ]; then
  printf '  continuum autosave: off\n'
  canopy_rc_problem "autosave is off: @continuum-save-interval is $canopy_rc_interval"
else
  printf '  continuum autosave: every %s minutes\n' "$canopy_rc_interval"
fi

case "$(canopy_rc_option status-interval)" in
  0) canopy_rc_problem "status-interval is 0, so the status line never redraws and continuum's autosave never fires" ;;
  *) ;;
esac

# How long ago a save last ran. Two sources, because neither alone is the
# truth: resurrect leaves the save file untouched when the new save is byte
# identical to the last one, so an idle machine's file ages while autosave
# is working perfectly, and continuum's own timestamp is set at load before
# any file exists. The newer of the two is when autosave last ran.
canopy_rc_last=""
canopy_rc_stamp="$(canopy_rc_option @continuum-save-last-timestamp)"
case "$canopy_rc_stamp" in
  '' | *[!0-9]*) ;;
  *) canopy_rc_last="$canopy_rc_stamp" ;;
esac
if [ -e "$canopy_rc_save_file" ]; then
  canopy_rc_mtime="$(canopy_stat_field '%Y' '%m' "$canopy_rc_save_file")" || canopy_rc_mtime=""
  case "$canopy_rc_mtime" in
    '' | *[!0-9]*) ;;
    *)
      if [ -z "$canopy_rc_last" ] || [ "$canopy_rc_mtime" -gt "$canopy_rc_last" ]; then
        canopy_rc_last="$canopy_rc_mtime"
      fi
      ;;
  esac
fi

if [ -z "$canopy_rc_last" ]; then
  printf '  last save: never\n'
  canopy_rc_problem "continuum has not run on this server, so nothing is being saved"
else
  canopy_rc_age=$(($(date +%s) - canopy_rc_last))
  [ "$canopy_rc_age" -ge 0 ] || canopy_rc_age=0
  canopy_rc_minutes=$((canopy_rc_age / 60))
  if [ "$canopy_rc_minutes" -eq 0 ]; then
    printf '  last save: less than a minute ago\n'
  elif [ "$canopy_rc_minutes" -eq 1 ]; then
    printf '  last save: 1 minute ago\n'
  else
    printf '  last save: %s minutes ago\n' "$canopy_rc_minutes"
  fi
  # Twice the configured interval. One missed tick is ordinary: continuum's
  # save rides on a status line redraw, and a redraw can be late or, while
  # nothing is attached, not happen at all. Two missed ticks is a timer
  # that is not running.
  if [ "$canopy_rc_interval_ok" -eq 1 ] &&
    [ "$canopy_rc_age" -gt $((canopy_rc_interval * 120)) ]; then
    canopy_rc_problem "autosave has not run for $((canopy_rc_age / 60)) minutes, more than twice the $canopy_rc_interval minute @continuum-save-interval"
  fi
fi
printf '  saves: %s\n' "$canopy_rc_dir"

if [ -n "$canopy_rc_problems" ]; then
  printf '\nPersistence is misconfigured:\n'
  printf '%s' "$canopy_rc_problems"
  exit 2
fi

if [ "$canopy_rc_total" -ne "$canopy_rc_resuming" ]; then
  printf '\n%s of %s agent panes will resume.\n' "$canopy_rc_resuming" "$canopy_rc_total"
  exit 1
fi

exit 0
