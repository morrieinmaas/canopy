#!/bin/sh
# canopy:summary=Install canopy, migrating any existing tmux config
# canopy:group=core
# canopy:args=[--yes] [--dry-run]
# canopy:examples=canopy install --yes
# shellcheck disable=SC2154  # CANOPY_CONFIG/CANOPY_STATE are exported by lib/env.sh's canopy_paths
set -eu

: "${CANOPY_STORE:=$(cd "$(dirname "$0")/.." && pwd)}"
# shellcheck source=../lib/env.sh
# shellcheck disable=SC1091
. "$CANOPY_STORE/lib/env.sh"
# shellcheck source=../lib/manifest.sh
# shellcheck disable=SC1091
. "$CANOPY_STORE/lib/manifest.sh"
# shellcheck source=../lib/tmux.sh
# shellcheck disable=SC1091
. "$CANOPY_STORE/lib/tmux.sh"
canopy_paths

yes=0
dry_run=0
for arg in "$@"; do
  case "$arg" in
    --yes) yes=1 ;;
    --dry-run) dry_run=1 ;;
    *) canopy_die "canopy-install: unknown argument: $arg" ;;
  esac
done

# tmux's own precedence: ~/.tmux.conf wins when present, else the XDG path.
xdg_conf_home="${XDG_CONFIG_HOME:-$HOME/.config}"
xdg_tmux_conf="$xdg_conf_home/tmux/tmux.conf"
dot_tmux_conf="$HOME/.tmux.conf"

# Written into every entry point canopy-install ever creates or replaces —
# both branches below call write_entry_stub so the text can never diverge —
# and how a re-run recognises its own file instead of migrating it.
entry_marker='# canopy:entry-point'

write_entry_stub() {
  printf '%s — managed by canopy, do not edit directly.\n' "$entry_marker" >"$1"
  cat >>"$1" <<'EOF'
# Any original content was migrated to $CANOPY_CONFIG/user.conf.
source-file "$CANOPY_STORE/tmux/tmux.conf"
EOF
}

user_entry=""
if [ -f "$dot_tmux_conf" ]; then
  user_entry="$dot_tmux_conf"
elif [ -f "$xdg_tmux_conf" ]; then
  user_entry="$xdg_tmux_conf"
fi

already_installed=0
if [ -n "$user_entry" ] && grep -qF "$entry_marker" "$user_entry"; then
  already_installed=1
fi

if [ "$already_installed" -eq 1 ]; then
  if [ "$dry_run" -eq 1 ]; then
    printf 'canopy is already installed: %s already sources canopy — nothing to do\n' "$user_entry"
    exit 0
  fi
  canopy_die "canopy is already installed: $user_entry already sources canopy's tmux.conf — nothing to migrate"
fi

mise_conf_dir="$xdg_conf_home/mise/conf.d"
mise_frag="$mise_conf_dir/canopy.toml"
write_mise=0
if [ -d "$mise_conf_dir" ] || canopy_have mise; then
  write_mise=1
fi

print_plan() {
  if [ -f "$CANOPY_CONFIG/user.conf" ]; then
    printf 'own %s (backed up)\n' "$CANOPY_CONFIG/user.conf"
  else
    printf 'create %s\n' "$CANOPY_CONFIG/user.conf"
  fi
  if [ -n "$user_entry" ]; then
    printf 'own %s (backed up) and migrate it into %s\n' "$user_entry" "$CANOPY_CONFIG/user.conf"
  else
    printf 'create entry point %s, sourcing the store tmux.conf\n' "$xdg_tmux_conf"
  fi
  if [ "$write_mise" -eq 1 ]; then
    printf 'write %s\n' "$mise_frag"
  fi
  printf 'run canopy-caps\n'
  printf 'run canopy-index\n'
  printf 'validate the resulting tmux config\n'
}

if [ "$dry_run" -eq 1 ]; then
  print_plan
  exit 0
fi

if [ -n "$user_entry" ] && [ "$yes" -ne 1 ]; then
  printf 'canopy install found an existing tmux config and would migrate it:\n'
  print_plan
  canopy_die "owning $user_entry is a migration, not a merge — re-run with --yes to proceed"
fi

tx="$(canopy_tx_begin install)"

mkdir -p "$CANOPY_CONFIG"
if [ -f "$CANOPY_CONFIG/user.conf" ]; then
  canopy_tx_record "$tx" own "$CANOPY_CONFIG/user.conf"
else
  canopy_tx_record "$tx" drop "$CANOPY_CONFIG/user.conf"
  printf '# canopy user config — sourced last, wins over every shipped default.\n' >"$CANOPY_CONFIG/user.conf"
fi

if [ -n "$user_entry" ]; then
  canopy_tx_record "$tx" own "$user_entry"
  {
    printf '\n# canopy: migrated from %s on %s\n' "$user_entry" "$(date +%Y-%m-%d)"
    cat "$user_entry"
  } >>"$CANOPY_CONFIG/user.conf"
  write_entry_stub "$user_entry"
else
  # No pre-existing config anywhere canopy or tmux would look: canopy still
  # "owns the entry point" (spec 5.2), so create one at the XDG path. It is
  # a brand-new file (action drop, pre-state absent), not a migration.
  entry_dir="$(dirname "$xdg_tmux_conf")"
  entry_dir_created=0
  [ -d "$entry_dir" ] || entry_dir_created=1
  canopy_tx_record "$tx" drop "$xdg_tmux_conf"
  mkdir -p "$entry_dir"
  write_entry_stub "$xdg_tmux_conf"
  if [ "$entry_dir_created" -eq 1 ]; then
    # The manifest format models files, not directories, so a directory
    # canopy-install itself created (to hold the file above) is tracked in
    # a sidecar next to restore.sh instead of as a manifest row. The
    # cleanup snippet is spliced in before restore.sh's own final summary
    # line (not appended after it), so the summary reflects a finished
    # restore. It contains no interpolated path data — just a static loop
    # over the sidecar file, mirroring how restore.sh already reads
    # manifest.tsv line-by-line.
    printf '%s\n' "$entry_dir" >>"$tx/dirs-created.txt"
    final_line="$(tail -n 1 "$tx/restore.sh")"
    sed '$d' "$tx/restore.sh" >"$tx/restore.sh.new"
    cat >>"$tx/restore.sh.new" <<'RESTORE_DIRS_EOF'

# Directories canopy-install created solely to hold a fresh entry point:
# removed only if still empty, so pre-existing sibling content (e.g. an
# unrelated plugins/ dir under the same path) is kept.
if [ -f "$dir/dirs-created.txt" ]; then
  while IFS= read -r d; do
    rmdir "$d" 2>/dev/null || :
  done <"$dir/dirs-created.txt"
fi
RESTORE_DIRS_EOF
    printf '%s\n' "$final_line" >>"$tx/restore.sh.new"
    mv "$tx/restore.sh.new" "$tx/restore.sh"
    chmod +x "$tx/restore.sh"
  fi
fi

if [ "$write_mise" -eq 1 ]; then
  canopy_tx_record "$tx" drop "$mise_frag"
  mkdir -p "$mise_conf_dir"
  cat >"$mise_frag" <<'EOF'
# Managed by canopy — do not edit; overwritten by `canopy install`.
[tools]
fzf = "latest"
gum = "latest"
starship = "latest"
EOF
fi

"$CANOPY_STORE/bin/canopy-caps"
"$CANOPY_STORE/bin/canopy-index"

if canopy_tmux_validate "$CANOPY_STORE/tmux/tmux.conf"; then
  canopy_tx_commit "$tx"
  touch "$tx/.pinned"
  printf 'canopy installed.\n'
else
  "$tx/restore.sh"
  touch "$tx/.failed"
  canopy_die "the resulting tmux config failed validation — installation rolled back"
fi
