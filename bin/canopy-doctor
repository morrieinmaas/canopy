#!/bin/sh
# canopy:summary=Report what is working, what is dormant, and why
# canopy:group=core
# shellcheck disable=SC2154,SC2153  # CANOPY_CONFIG/CANOPY_STATE are exported by lib/env.sh's canopy_paths
set -eu

: "${CANOPY_STORE:=$(cd "$(dirname "$0")/.." && pwd)}"
# shellcheck source=../lib/env.sh
# shellcheck disable=SC1091
. "$CANOPY_STORE/lib/env.sh"
# shellcheck source=../lib/tmux.sh
# shellcheck disable=SC1091
. "$CANOPY_STORE/lib/tmux.sh"
# shellcheck source=../lib/plugins.sh
# shellcheck disable=SC1091
. "$CANOPY_STORE/lib/plugins.sh"
canopy_paths

if [ $# -gt 0 ]; then
  canopy_die "canopy-doctor: unknown argument: $1"
fi

warnings=0
load_bearing_failed=0

printf 'canopy doctor\n'
printf '=============\n\n'

# --- Environment -------------------------------------------------------
printf 'Environment:\n'
if tmux_raw="$(tmux -V 2>/dev/null)"; then
  printf '  tmux: %s\n' "$tmux_raw"
else
  printf '  tmux: not found\n'
fi
printf '  shell: %s\n' "$(command -v sh 2>/dev/null || printf 'sh')"
printf '  store: %s\n' "$CANOPY_STORE"
printf '  config: %s\n' "$CANOPY_CONFIG"
printf '  state: %s\n' "$CANOPY_STATE"
printf '\n'

# --- Capabilities --------------------------------------------------------
# The tool set and order mirror canopy-caps exactly, so this section is a
# direct read of what canopy-caps already probed and wrote; doctor never
# re-probes capabilities itself.
tools="wt fzf gum ghostty starship mise"
caps_file="$CANOPY_STATE/05-caps.conf"
printf 'Capabilities:\n'
if [ -f "$caps_file" ]; then
  for tool in $tools; do
    val="$(awk -v t="@canopy_has_$tool" '$3 == t { print $4 }' "$caps_file")"
    if [ "$val" = "1" ]; then
      printf '  %s: yes\n' "$tool"
    else
      printf '  %s: no\n' "$tool"
    fi
  done
else
  printf '  not yet generated (run: canopy caps)\n'
  warnings=$((warnings + 1))
fi
printf '\n'

# --- Layers ----------------------------------------------------------------
# M1 ships no optional conf.d layer files yet (only 00-core and the
# generated 05-caps); every layer that exists in the spec's layer table is
# still capability-gated future work. What doctor CAN report honestly today
# is exactly what each capability enables once its layer ships: the same
# data as Capabilities, framed by feature name instead of raw tool name, per
# the design doc's own worked example ("worktree: wt not found"). "wt" is
# the only tool the design doc names a layer for (worktree); the rest reuse
# the tool name until their own layer ships and earns a name.
layer_pairs="wt:worktree fzf:fzf gum:gum ghostty:ghostty starship:starship mise:mise"
printf 'Layers:\n'
if [ -f "$caps_file" ]; then
  for pair in $layer_pairs; do
    tool="${pair%%:*}"
    label="${pair#*:}"
    val="$(awk -v t="@canopy_has_$tool" '$3 == t { print $4 }' "$caps_file")"
    if [ "$val" = "1" ]; then
      printf '  %s (%s): active\n' "$label" "$tool"
    else
      printf '  %s (%s): dormant (%s not found)\n' "$label" "$tool" "$tool"
    fi
  done
else
  printf '  unknown, capabilities not yet probed (run: canopy caps)\n'
fi
printf '\n'

# --- Plugins ---------------------------------------------------------------
# Two questions per vendored plugin, and they are different questions.
# "Pinned at" comes from plugins/VERSIONS and says which upstream commit
# this checkout claims. "Tree matches" compares the bytes on disk against
# the digest plugins/vendor.sh recorded when it wrote them, and it is the
# only one of the two that can catch a tree edited in place. Reporting the
# commit alone would let a locally patched plugin keep presenting an
# upstream sha, which is how a persistence bug ends up being debugged
# against source that is not what is running.
#
# Names are read once into a variable rather than iterated straight out of
# a pipe: a `while read` on the right of a pipe runs in a subshell, and
# every warnings increment inside it would be discarded at the pipe's end.
plugin_names="$(canopy_plugin_names 2>/dev/null || true)"
printf 'Plugins:\n'
if [ -z "$plugin_names" ]; then
  printf '  none vendored (no plugins/VERSIONS in the store)\n'
  warnings=$((warnings + 1))
else
  # Both vendored plugins are upstream bash scripts. Where bash is absent,
  # which is the normal state of an Alpine or other BusyBox userland, the
  # layer goes dormant: no binding, no autosave, no restore after a
  # reboot. Said here, once, rather than left for the reboot to reveal.
  #
  # Reported as dormant and not counted as a warning, the same as every
  # other capability-gated layer above: an absent optional tool is a
  # description of the machine, not a fault in the install. The verdict
  # that an agent pane will not survive a reboot belongs to
  # `canopy reboot-check`, whose entire job is to judge that, not to
  # doctor, whose job is to describe.
  if canopy_have bash; then
    printf '  bash (both plugins are bash scripts): yes\n'
  else
    printf '  bash (both plugins are bash scripts): dormant (bash not found, the layer loads nothing)\n'
  fi

  # ps is the other half of the same story and the nastier half. An absent
  # bash leaves the plugins unloaded and visibly dormant; a ps that cannot
  # report a process's parent leaves every plugin loaded and quietly
  # useless, because canopy recognises an agent pane by asking ps what the
  # pane's process is running (lib/pane.sh). Where the answer is empty,
  # reboot-check reports no agent panes on a machine full of them, and the
  # save strategy records shells. Nothing else would ever say so.
  #
  # Probed by running it rather than by looking for the binary: BusyBox
  # ships a ps that exists and cannot answer this question.
  #
  # The question is asked of one known process rather than by running
  # lib/pane.sh's own `ps -ao ppid,args`, for two reasons found by having
  # written it that way first. That form exits non-zero on a working
  # machine, 1 with procps and 2 on macOS, and pane.sh never noticed
  # because it reads the pipeline's status rather than ps's. And `-a`
  # lists only processes with a terminal, so run from a script with no
  # tty it reports nothing at all on Linux while working perfectly inside
  # the panes canopy actually asks about. Either way round, the check
  # would have described the prober instead of the machine.
  # continuum's autosave hook, checked on the server that is actually
  # running rather than on a scratch one.
  #
  # continuum prepends `#(continuum_save.sh)` to status-right when the
  # plugin layer loads, and that interpolation IS the autosave: it fires
  # on status redraws, so a status-right without it is a server that never
  # saves. Any config setting status-right after the plugin layer removes
  # it, which is why canopy's own status layer is numbered 20 and why
  # user.conf should append with `set -ag`.
  #
  # A scratch server cannot answer this: continuum skips installing the
  # hook whenever another tmux server is running, which is true of every
  # machine that is using tmux right now. The live server is both the
  # honest place to ask and the only place the answer matters.
  if tmux list-sessions >/dev/null 2>&1; then
    doctor_status_right="$(tmux show -gv status-right 2>/dev/null)" || doctor_status_right=""
    case "$doctor_status_right" in
      *continuum_save.sh*)
        printf '  continuum autosave hook in status-right: present\n'
        ;;
      *)
        printf '  continuum autosave hook in status-right: MISSING, so this server never autosaves\n'
        printf '    something set status-right after the plugin layer; append instead: set -ag status-right "..."\n'
        warnings=$((warnings + 1))
        ;;
    esac
  fi

  doctor_ps_parent="$(ps -o ppid= -p "$$" 2>/dev/null | tr -d ' ')" || doctor_ps_parent=""
  case "$doctor_ps_parent" in
    '' | *[!0-9]*)
      printf '  ps (agent panes are recognised through it): dormant (this ps cannot report a process parent, so no pane is recognised as an agent)\n'
      ;;
    *) printf '  ps (agent panes are recognised through it): yes\n' ;;
  esac
  for plugin_name in $plugin_names; do
    plugin_pin="$(canopy_plugin_pin "$plugin_name" 2>/dev/null || true)"
    plugin_commit="${plugin_pin#* }"
    plugin_dir="$CANOPY_STORE/plugins/$plugin_name"
    if [ ! -d "$plugin_dir" ]; then
      printf '  %s: pinned %s, tree MISSING from plugins/ (re-vendor with: plugins/vendor.sh %s)\n' \
        "$plugin_name" "$plugin_commit" "$plugin_name"
      warnings=$((warnings + 1))
      continue
    fi
    plugin_recorded="$(canopy_plugin_recorded_digest "$plugin_name" 2>/dev/null || true)"
    plugin_actual="$(canopy_plugin_digest "$plugin_dir")"
    if [ -z "$plugin_recorded" ]; then
      printf '  %s: pinned %s, no digest in plugins/CHECKSUMS, cannot tell whether the tree is intact\n' \
        "$plugin_name" "$plugin_commit"
      warnings=$((warnings + 1))
    elif [ "$plugin_recorded" = "$plugin_actual" ]; then
      printf '  %s: pinned %s, tree matches\n' "$plugin_name" "$plugin_commit"
    else
      printf '  %s: pinned %s, tree MODIFIED since it was vendored (re-vendor with: plugins/vendor.sh %s)\n' \
        "$plugin_name" "$plugin_commit" "$plugin_name"
      warnings=$((warnings + 1))
    fi
  done
fi
printf '\n'

# --- Load-bearing settings --------------------------------------------------
# From M1: the tmux version floor, the shipped config validating on a
# scratch socket, and user.conf being sourced last. From M2:
# @continuum-restore, without which a reboot restores nothing. Failing any
# of these is what earns exit 2, not a warning.
printf 'Load-bearing settings:\n'

if canopy_tmux_version_ok; then
  printf '  tmux version floor (>= 3.4): ok\n'
else
  printf '  tmux version floor (>= 3.4): FAILED (found: %s)\n' "${tmux_raw:-not found}"
  load_bearing_failed=1
fi

# What gets validated is the entry point tmux actually loads on this
# machine, from the bare environment canopy_tmux_validate imposes. Doctor
# used to validate the store's own tmux.conf while this process had
# CANOPY_* exported, and so reported OK on a machine whose installed
# config loaded nothing whatsoever. A check that runs the artifact through
# a richer environment than the user has is not a check.
#
# canopy_tmux_validate is called directly as the if-condition, not wrapped
# in a nested command substitution: under `set -e`, canopy_tmux_validate's
# own internal `err="$(tmux ... )"` assignment is only exempt from -e when
# the function itself is the direct condition being tested, not when it
# is nested one command-substitution subshell deeper; nesting it would
# abort that subshell before kill-server ever runs, leaking the scratch
# server. Output goes to a real file for the same reason: a still-running
# descendant holding a pipe open can hang a reader waiting on EOF; a file
# has no such hazard.
canopy_runtime_ensure
validate_tmp="$CANOPY_RUNTIME/doctor-validate.$$"
trap 'rm -f "$validate_tmp"' EXIT
entry_point="$(canopy_entry_point)"
if [ -z "$entry_point" ]; then
  # No entry point means canopy is not installed, so there is no shipped
  # artifact to run through a user's entry path, and nothing doctor could
  # honestly validate in its place. Reported as a warning rather than
  # silence: "canopy doctor: OK" on a machine with no canopy on it is the
  # same lie in a smaller costume.
  printf '  installed entry point: none, canopy is not installed (run: canopy install)\n'
  warnings=$((warnings + 1))
else
  printf '  installed entry point: %s\n' "$entry_point"
  entry_point_loads=0
  if canopy_tmux_validate "$entry_point" >"$validate_tmp" 2>&1; then
    printf '  entry point loads from a bare environment: ok\n'
    entry_point_loads=1
  else
    printf '  entry point loads from a bare environment: FAILED\n'
    while IFS= read -r line; do
      printf '    %s\n' "$line"
    done <"$validate_tmp"
    load_bearing_failed=1
  fi

  # @continuum-restore, the setting spec 5.3 hands to doctor, and the one
  # that decides whether a reboot returns anything at all. continuum
  # defaults it to off, so a config that fails to set it leaves the rest
  # of persistence writing save files that nothing ever reads back.
  #
  # Read off the same entry point that was just validated, so a user.conf
  # that turned it off is caught here rather than after somebody's reboot.
  #
  # Only asked when that entry point actually loaded. A config tmux
  # refused has no loaded value to report, so asking would add a second
  # failure line for one cause and point the reader at the wrong file: the
  # setting is not missing, the config it lives in never ran.
  # shellcheck disable=SC2310  # a state question, so a non-zero return is the answer and not a failure to abort on
  if [ "$entry_point_loads" -eq 0 ]; then
    printf '  @continuum-restore is on: not checked, the entry point does not load\n'
  elif restore_option="$(canopy_tmux_loaded_option "$entry_point" @continuum-restore)" &&
    [ "$restore_option" = "on" ]; then
    printf '  @continuum-restore is on: ok\n'
  else
    printf '  @continuum-restore is on: FAILED (the loaded config leaves it %s)\n' \
      "${restore_option:-unset}"
    printf '    nothing would be restored after a reboot; set it back with: set -g @continuum-restore on in %s/user.conf\n' \
      "$CANOPY_CONFIG"
    load_bearing_failed=1
  fi
fi
rm -f "$validate_tmp"

# Checked textually against the store's own tmux.conf (never against a real
# $HOME entry point): the last `source-file` directive must target
# user.conf, so a later layer can never be sourced after it and win instead.
last_source="$(grep '^source-file' "$CANOPY_STORE/tmux/tmux.conf" | tail -n 1)"
# The literal string in the pattern below is intentional: it matches the
# raw tmux.conf text, not a shell-expanded path.
# shellcheck disable=SC2016
case "$last_source" in
  *'$CANOPY_CONFIG/user.conf'*)
    printf '  user.conf sourced last: ok\n'
    ;;
  *)
    printf '  user.conf sourced last: FAILED (last source-file line: %s)\n' "$last_source"
    load_bearing_failed=1
    ;;
esac
printf '\n'

# --- Restore points ----------------------------------------------------

# canopy_doctor_tx_reverted <txdir>
# True when every path <txdir> recorded currently holds the exact state it
# held before that transaction touched it, i.e. the transaction's effect is
# no longer on the machine.
#
# Doctor asks this of the machine rather than of the ledger on purpose. A
# "recovered" marker could only ever be written by canopy-restore, and the
# recovery route canopy documents for the case where canopy itself is
# broken is the transaction's own self-contained restore.sh, which knows
# nothing about canopy and can write no marker. So can a user putting the
# file back by hand. All three leave the same machine behind, and the
# machine is what doctor exists to report on.
#
# A transaction that recorded nothing is vacuously reverted: it changed
# nothing, so there is nothing to put back.
canopy_doctor_tx_reverted() {
  canopy_doctor_tab="$(printf '\t')"
  canopy_doctor_verdict=0
  while IFS="$canopy_doctor_tab" read -r row_action row_path row_pre row_backup row_post; do
    case "$row_action" in
      '#'* | '') continue ;;
      *) ;;
    esac
    : "$row_backup" "$row_post"
    if [ "$(canopy_file_state "$row_path")" != "$row_pre" ]; then
      canopy_doctor_verdict=1
      break
    fi
  done <"$1/manifest.tsv"
  return "$canopy_doctor_verdict"
}

printf 'Restore points:\n'
restore_count=0
pinned_found=no
recovered_count=0
incomplete_list=""
if [ -d "$CANOPY_STATE/backups" ]; then
  for d in "$CANOPY_STATE"/backups/*/; do
    [ -d "$d" ] || continue
    d="${d%/}"
    if [ -f "$d/.committed" ]; then
      restore_count=$((restore_count + 1))
      if [ -f "$d/.pinned" ]; then
        pinned_found=yes
      fi
    elif [ ! -f "$d/.failed" ]; then
      # Recorded rows, no .committed marker and no .failed marker: canopy
      # was interrupted between migrating the user's files and committing
      # the transaction. The user's original bytes are sitting in this
      # directory's files/, and nothing else in canopy would say so. A
      # recovery tool that stays silent here is worse than no tool.
      #
      # Unless the user has already acted on that advice. Warning about a
      # transaction whose effect is no longer on disk tells someone who
      # did exactly what doctor asked that their machine still needs
      # attention, which is how a diagnostic stops being believed.
      # shellcheck disable=SC2310  # a state question, so its non-zero return is the answer, not a failure to abort on
      if canopy_doctor_tx_reverted "$d"; then
        recovered_count=$((recovered_count + 1))
      else
        incomplete_list="$incomplete_list$d
"
      fi
    fi
  done
fi
printf '  count: %s\n' "$restore_count"
printf '  pinned pre-install point: %s\n' "$pinned_found"
if [ "$recovered_count" -gt 0 ]; then
  printf '  %s interrupted transaction(s) already reverted, nothing to do\n' "$recovered_count"
fi
if [ -n "$incomplete_list" ]; then
  printf '%s' "$incomplete_list" | while IFS= read -r d; do
    [ -n "$d" ] || continue
    printf '  INCOMPLETE transaction, interrupted before it committed: %s\n' "${d##*/}"
    printf '    your original files are backed up under %s\n' "$d/files"
    printf '    recover with: canopy restore --to %s\n' "${d##*/}"
  done
  warnings=$((warnings + 1))
fi
printf '\n'

# --- Commands ------------------------------------------------------------
printf 'Commands:\n'
commands_file="$CANOPY_STATE/commands.tsv"
if [ -f "$commands_file" ]; then
  missing="$(awk -F'\t' '$3 == "" { print $1 }' "$commands_file")"
  if [ -n "$missing" ]; then
    printf '%s\n' "$missing" | while IFS= read -r name; do
      printf '  missing summary header: canopy-%s\n' "$name"
    done
    warnings=$((warnings + 1))
  else
    printf '  all commands carry a summary header\n'
  fi
else
  printf '  not yet generated (run: canopy index)\n'
  warnings=$((warnings + 1))
fi
printf '\n'

# --- Keybindings -----------------------------------------------------------
# Deliberately stubbed: the key table (spec 4.4) does not exist until M4, so
# there is nothing to cross-reference `list-keys` against yet. Said here
# rather than left out silently.
printf 'Keybindings:\n'
if [ ! -f "$CANOPY_STORE/tmux/keys.tsv" ]; then
  printf '  no key table in the store, so canopy binds nothing\n'
  warnings=$((warnings + 1))
elif [ ! -f "$CANOPY_STATE/10-keys.conf" ]; then
  printf '  key table present, layer not yet generated (run: canopy keys)\n'
  warnings=$((warnings + 1))
else
  # Both numbers come from counting, not from a recorded total: a table
  # that grew a row without the layer being regenerated is exactly the
  # drift worth reporting, and it is invisible to anything that trusts a
  # stored count.
  keys_declared="$(grep -cv '^#' "$CANOPY_STORE/tmux/keys.tsv" 2>/dev/null || printf '0')"
  keys_bound="$(grep -c '^bind ' "$CANOPY_STATE/10-keys.conf" 2>/dev/null || printf '0')"
  if [ "$keys_declared" -eq "$keys_bound" ]; then
    printf '  %s keys declared in the table, %s bound in the generated layer\n' \
      "$keys_declared" "$keys_bound"
  else
    printf '  %s keys declared in the table but %s bound: the layer is stale (run: canopy keys)\n' \
      "$keys_declared" "$keys_bound"
    warnings=$((warnings + 1))
  fi
  printf '  live list-keys cross-check: still stubbed, it arrives with the palette in M4\n'
fi
printf '\n'

if [ "$load_bearing_failed" -eq 1 ]; then
  printf 'canopy doctor: FAILED, a load-bearing check did not pass\n'
  exit 2
elif [ "$warnings" -gt 0 ]; then
  printf 'canopy doctor: %d warning(s)\n' "$warnings"
  exit 1
else
  printf 'canopy doctor: OK\n'
  exit 0
fi
